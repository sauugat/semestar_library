# Semester Library — Environment Configuration Template
# Copy to `.env` for local development or configure in Vercel Project Settings.
# NEVER commit real API keys, database URLs, OAuth client secrets, or tokens.

# ----------------------------------------------------------------------------
# 1. Database & Session Configuration
# ----------------------------------------------------------------------------
# PostgreSQL (Neon) connection string for production; leave unset locally to use SQLite (`database.db`).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ----------------------------------------------------------------------------
# 2. Teacher-Owned Google Drive Attendance Backup (OAuth 2.0 Public Client IDs)
# ----------------------------------------------------------------------------
# Required OAuth Scope: https://www.googleapis.com/auth/drive.file
# Do NOT configure or send any Google OAuth Client Secret (`GOCSPX-...`) to the client or backend.
# When left blank or set to a `YOUR_*` placeholder, the app safely reports `NOT CONFIGURED`
# and all classroom attendance marking, 24h edits, and history continue normally.
GOOGLE_DRIVE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_DRIVE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_DRIVE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com

# Optional Expo public aliases (also recognized by the backend and mobile app):
EXPO_PUBLIC_GOOGLE_DRIVE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_DRIVE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_DRIVE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com

# ----------------------------------------------------------------------------
# 3. Kyana AI Study Assistant (Optional)
# ----------------------------------------------------------------------------
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
# CHAT_PROVIDER=gemini
