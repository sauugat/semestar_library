{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": ["@cloudflare/workers-types"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@semester-library/ludo-engine": ["../packages/ludo-engine/src/index.ts"]
    }
  },
  "include": ["src/**/*", "../packages/ludo-engine/src/**/*"]
}
