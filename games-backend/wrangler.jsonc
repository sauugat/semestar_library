{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "semester-library-games",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
