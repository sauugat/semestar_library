# Semester Library Mobile (Expo SDK 57) — Environment Configuration Template
# Copy to `mobile/.env` for local/EAS builds. Never commit real credentials or tokens.
#
# Application Identifiers (from `mobile/app.json`):
# - iOS Bundle Identifier: `com.semesterlibrary.app`
# - Android Package Name:  `com.semesterlibrary.app`
# - Native Redirect URI:   `com.googleusercontent.apps.<CLIENT_ID_PREFIX>:/oauthredirect`
# - Required OAuth Scope:  `https://www.googleapis.com/auth/drive.file`

EXPO_PUBLIC_API_URL=https://semestar-library.vercel.app

# Teacher-Owned Google Drive Attendance Backup OAuth 2.0 Client IDs (Placeholders Only)
# When unset or left as `YOUR_*` placeholders, the mobile Attendance Backup card
# displays `NOT CONFIGURED` and leaves all attendance features working normally.
EXPO_PUBLIC_GOOGLE_DRIVE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_DRIVE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_DRIVE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
