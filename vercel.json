{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/push/process",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/internal/posts/cleanup-staging",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/internal/knowledge/worker",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/internal/knowledge/reconcile",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/knowledge/sync-university",
      "schedule": "0 6,12 * * *"
    }
  ]
}
