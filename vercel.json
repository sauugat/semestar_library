{
  "version": 2,
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)\\.(css|js|woff2|woff|ttf|webp|png|jpg|jpeg|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(auth|academic-context|sw|js/teacher-attendance|js/student-attendance|js/attendance-drive-sync)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/syllabus-data\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/push/process",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/internal/posts/cleanup-staging",
      "schedule": "0 2 * * *"
    }
  ]
}
